{
  "version": 6,
  "configurePresets": [
    {"name":"host-debug","binaryDir":"${sourceDir}/build/host-debug","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","DMG_BUILD_TESTS":"ON"}},
    {"name":"host-asan","inherits":"host-debug","binaryDir":"${sourceDir}/build/host-asan","cacheVariables":{"DMG_ENABLE_ASAN":"ON"}}
  ],
  "buildPresets": [
    {"name":"host-debug","configurePreset":"host-debug","configuration":"Debug"},
    {"name":"host-asan","configurePreset":"host-asan","configuration":"Debug"}
  ],
  "testPresets": [
    {"name":"host-debug","configurePreset":"host-debug","configuration":"Debug","output":{"outputOnFailure":true}},
    {"name":"host-asan","configurePreset":"host-asan","configuration":"Debug","output":{"outputOnFailure":true}}
  ]
}
