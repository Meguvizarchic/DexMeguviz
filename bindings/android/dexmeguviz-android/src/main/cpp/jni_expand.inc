void expand_identity(GraphWriter& w,const dmg_value_identity_v2& v,uint32_t sources,bool absent=false){
    if(absent&&v.source_index==UINT32_MAX&&v.local_index==UINT32_MAX){for(auto x:{v.relation,v.source_index,v.local_index,v.dex_pc})w.u32(x);return;}
    use_identity(w,v,sources);
}
void expand_binding(GraphWriter& w,const dmg_expand_binding& b,uint32_t node,uint32_t sources){w.u32(node);w.ascii(b.label);w.path(b.path);use_value(w,b.value,31,sources);}
void expand_row_evidence(GraphWriter& w,const dmg_result* result,uint32_t row,uint32_t sources){
    dmg_expand_row_evidence_info c{};graph_ok(dmg_result_get_expand_row_evidence_info(result,row,&c,sizeof(c)));
    w.item(c.binding_count);w.u32(c.binding_count);for(uint32_t i=0;i<c.binding_count;++i){dmg_expand_binding b{};graph_ok(dmg_result_get_expand_row_binding(result,row,i,&b,sizeof(b)));expand_binding(w,b,UINT32_MAX,sources);}
    w.item(c.link_count);w.u32(c.link_count);for(uint32_t i=0;i<c.link_count;++i){dmg_relation_link_v2 v{};graph_ok(dmg_result_get_expand_row_link(result,row,i,&v,sizeof(v)));w.u32(v.node_id);w.u32(v.key);expand_identity(w,v.left,sources);expand_identity(w,v.right,sources);}
    w.item(c.proof_count);w.u32(c.proof_count);for(uint32_t i=0;i<c.proof_count;++i){dmg_expand_proof v{};graph_ok(dmg_result_get_expand_row_proof(result,row,i,&v,sizeof(v)));expand_binding(w,v.binding,v.operator_node,sources);}
    w.item(c.witness_count);w.u32(c.witness_count);for(uint32_t i=0;i<c.witness_count;++i){dmg_relation_witness_v2 v{};graph_ok(dmg_result_get_expand_row_witness(result,row,i,&v,sizeof(v)));const auto& x=v.witness;for(auto n:{x.kind,x.node_id,x.matched,x.dex_pc,x.opcode,x.reference_index,x.reference_kind,x.extra_proto,x.code_units,v.operator_node})w.u32(n);expand_identity(w,v.entity,sources);}
}
void expand_evidence(GraphWriter& w,const ExpandAccess& a,uint32_t sources,uint32_t bindings,uint32_t links,uint32_t proofs,uint32_t seed,uint32_t walk,uint32_t emit,uint32_t hops){
    w.item(bindings);w.u32(bindings);for(uint32_t i=0;i<bindings;++i){dmg_expand_binding b{};graph_ok(a.binding(i,&b));expand_binding(w,b,UINT32_MAX,sources);}
    w.item(links);w.u32(links);for(uint32_t i=0;i<links;++i){dmg_relation_link_v2 l{};graph_ok(a.link(i,&l));w.u32(l.node_id);w.u32(l.key);expand_identity(w,l.left,sources);expand_identity(w,l.right,sources);}
    w.item(proofs);w.u32(proofs);for(uint32_t i=0;i<proofs;++i){dmg_expand_proof p{};graph_ok(a.proof(i,&p));expand_binding(w,p.binding,p.operator_node,sources);}
    const std::array<uint32_t,3> counts{seed,walk,emit};for(uint32_t which=0;which<counts.size();++which){const auto count=counts[which];w.item(count);w.u32(count);for(uint32_t i=0;i<count;++i){dmg_relation_witness_v2 v{};graph_ok(a.witness(which,i,&v));const auto& x=v.witness;for(auto n:{x.kind,x.node_id,x.matched,x.dex_pc,x.opcode,x.reference_index,x.reference_kind,x.extra_proto,x.code_units,v.operator_node})w.u32(n);expand_identity(w,v.entity,sources);}}
    w.item(hops);w.u32(hops);for(uint32_t i=0;i<hops;++i){dmg_expand_hop h{};graph_ok(a.hop(i,&h));expand_identity(w,h.caller,sources);expand_identity(w,h.resolved,sources);for(auto x:{h.dex_pc,h.code_offset,h.opcode,h.target_method_ref,h.candidate_count,h.resolution_complete})w.u32(x);w.entity(h.target_symbol,31,sources);}
}
void expand_frontier_wire(GraphWriter& w,const ExpandAccess& a,const dmg_expand_frontier& f,uint32_t sources){
    for(auto x:{f.node_id,f.depth,f.reason,f.dex_pc,f.target_method_ref,f.has_target_symbol})w.u32(x);
    expand_identity(w,f.seed,sources);expand_identity(w,f.current,sources);expand_identity(w,f.caller,sources,true);
    if(f.has_target_symbol)w.entity(f.target_symbol,31,sources);
    expand_evidence(w,a,sources,f.seed_binding_count,f.seed_link_count,f.seed_proof_count,f.seed_witness_count,f.walk_witness_count,f.emit_witness_count,f.prefix_count);
}
