option(DMG_BUILD_FUZZERS "Build development-only coverage-guided fuzz targets" OFF)
if(DMG_BUILD_FUZZERS)
  add_library(dmg_fuzz_miniz STATIC third_party/miniz/miniz.c)
  target_include_directories(dmg_fuzz_miniz PUBLIC third_party/miniz)
  target_compile_definitions(dmg_fuzz_miniz PUBLIC MINIZ_NO_STDIO MINIZ_NO_TIME MINIZ_NO_DEFLATE_APIS MINIZ_NO_ZLIB_COMPATIBLE_NAMES MINIZ_NO_MALLOC)
  add_library(dmg_fuzz_core STATIC ${DMG_CORE_SOURCES})
  target_compile_features(dmg_fuzz_core PRIVATE cxx_std_20)
  target_include_directories(dmg_fuzz_core PUBLIC include PRIVATE src)
  target_link_libraries(dmg_fuzz_core PUBLIC dmg_fuzz_miniz Threads::Threads)
  set(relation_fixture_header "${CMAKE_CURRENT_BINARY_DIR}/fuzz_relation_fixtures.hpp")
  file(WRITE "${relation_fixture_header}" "#pragma once\n#include <cstdint>\nnamespace dmg_fuzz_fixtures {\n")
  foreach(fixture definitions method_uses)
    if(fixture STREQUAL "definitions")
      set(fixture_path "${CMAKE_SOURCE_DIR}/tests/fixtures/generated/definition_catalog/definitions.dex")
    else()
      set(fixture_path "${CMAKE_SOURCE_DIR}/tests/fixtures/generated/method_facts/method-uses.dex")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fixture_path}")
    file(READ "${fixture_path}" fixture_hex HEX)
    file(SHA256 "${fixture_path}" fixture_sha256)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," fixture_bytes "${fixture_hex}")
    file(APPEND "${relation_fixture_header}" "inline constexpr uint8_t ${fixture}[] = {${fixture_bytes}};\ninline constexpr char ${fixture}_sha256[] = \"${fixture_sha256}\";\n")
  endforeach()
  file(APPEND "${relation_fixture_header}" "}\n")
  foreach(kind dex code archive query relational use_scan)
    add_executable(dmg_fuzz_${kind} fuzz/core_fuzzer.cpp)
    target_compile_features(dmg_fuzz_${kind} PRIVATE cxx_std_20)
    target_include_directories(dmg_fuzz_${kind} PRIVATE src)
    string(TOUPPER ${kind} upper)
    target_compile_definitions(dmg_fuzz_${kind} PRIVATE DMG_FUZZ_${upper}=1)
    target_link_libraries(dmg_fuzz_${kind} PRIVATE dmg_fuzz_core)
  endforeach()
  target_include_directories(dmg_fuzz_relational PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  foreach(target dmg_fuzz_miniz dmg_fuzz_core dmg_fuzz_dex dmg_fuzz_code dmg_fuzz_archive dmg_fuzz_query dmg_fuzz_relational dmg_fuzz_use_scan)
    if(MSVC)
      target_compile_definitions(${target} PUBLIC _ITERATOR_DEBUG_LEVEL=0)
      target_compile_options(${target} PRIVATE /fsanitize=fuzzer /fsanitize=address /Zi)
      target_link_options(${target} PRIVATE /INCREMENTAL:NO)
    else()
      target_compile_options(${target} PRIVATE -fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer)
      target_link_options(${target} PRIVATE -fsanitize=fuzzer,address,undefined)
    endif()
  endforeach()
endif()
